# Dockerfile para Backend (Node.js + Python 3 com suporte a Pillow e automações)
FROM node:22-bookworm-slim

# Instala dependências de sistema para Python, compilação de pacotes C e Pillow
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    libjpeg-dev \
    zlib1g-dev \
    libpng-dev \
    libfreetype6-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Cria ambiente virtual Python isolado
RUN python3 -m venv /app/.venv
ENV PATH="/app/.venv/bin:$PATH"

# Instala dependências Python
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Chromium para a curadoria por BUSCA no Pinterest. Falhar aqui não derruba a imagem: a busca cai para IA
# e a fonte "Minhas pastas" (RSS, sem navegador) continua funcionando.
RUN playwright install --with-deps chromium || echo "AVISO: Chromium nao instalado; a busca do Pinterest usara IA"

# Instala dependências Node
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Copia código-fonte do backend
COPY backend/ ./

# Garante permissões e criação de diretórios de armazenamento
RUN mkdir -p storage/carousels storage/library logs

EXPOSE 3131

CMD ["npm", "run", "dashboard"]
